    <string-array name="kv_labels">
        <item>f16 – keine Quantisierung, doppelter Speicher</item>
        <item>q8_0 – praktisch kein Verlust, halber Speicher (empfohlen)</item>
        <item>q5_0 – kleiner, Verlust bei langen Chats möglich</item>
        <item>q4_0 – am kleinsten, Verlust bei langen Chats möglich</item>
    </string-array>
    <string-array name="ub_labels">
        <item>32 – stabil</item>
        <item>64 – stabil, guter Kompromiss (empfohlen)</item>
        <item>128 – stabil, schnellerer Prefill</item>
        <item>256 – nicht getestet</item>
        <item>512 – llama.cpp-Standard; auf Adreno 840 + Gemma 4 + FA: GPU-Absturz</item>
    </string-array>
    <string-array name="load_labels">
        <item>auto – llama.cpp-Standard</item>
        <item>mmap – Modelldatei zusätzlich gemappt</item>
        <item>mmap+mlock – ohne Root wirkungslos</item>
        <item>mlock – ohne Root wirkungslos</item>
        <item>dio – Direct-IO beim Laden</item>
        <item>none – direkt in die GPU-Buffer (empfohlen)</item>
    </string-array>
    <string-array name="template_labels">
        <item>Jinja – Template aus dem Modell (Standard, nötig für Gemma 4, Tool-Calls, Thinking)</item>
        <item>--no-jinja – fest eingebaute llama.cpp-Templates (Gemma 4 geht damit nicht)</item>
    </string-array>
    <string-array name="reasoning_labels">
        <item>auto – Standard, Thinking an, wenn das Template es kann</item>
        <item>aus (--reasoning off) – wenn die Web-UI es nicht abschaltet</item>
        <item>an (--reasoning on)</item>
    </string-array>
    <string-array name="verbosity_labels">
        <item>1</item>
        <item>2</item>
        <item>3 – llama.cpp-Standard</item>
        <item>4 – sehr ausführlich</item>
    </string-array>
